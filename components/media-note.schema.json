{
  "$schema": "https://dots.design/schemas/component.schema.json",
  "slug": "media-note",
  "name": "MediaNote",
  "category": "conversation-media",
  "description": "插入 AI response 正文内容流的笔记媒体组件。",
  "harness": {
    "semantic": "用社区笔记补充相邻回答，并保留标题、作者和互动量。",
    "generation": [
      "单篇和两篇使用相同的大卡尺寸，三篇及以上切换为三列紧凑卡。",
      "最多展示前三篇，超过三篇时在卡组下展示更多笔记入口。",
      "视频笔记在右上角展示播放标识。"
    ],
    "validation": [
      "所有卡片比例 3:4、圆角 16px、间距 6px。",
      "单篇宽 161.5px；两篇每张尺寸与单篇一致；三篇横向撑满 329px。",
      "封面、底部渐变、标题、作者头像、作者名和点赞量完整。"
    ]
  },
  "props": {
    "count": { "values": [1, 2, 3, 4], "default": 1, "description": "笔记数量，4 表示 overflow。" },
    "mediaType": { "values": ["image", "video"], "default": "image", "description": "视频类型展示播放标识。" },
    "moreAction": { "values": [true, false], "default": true, "description": "超过三篇时打开完整笔记列表。" }
  },
  "states": ["single", "group-two", "group-three", "group-overflow"],
  "constraints": [
    { "rule": "maximum_visible_notes", "value": 3, "description": "内容流最多展示前三篇笔记。" },
    { "rule": "ratio", "value": "3:4", "description": "所有笔记卡固定为 3:4。" },
    { "rule": "single_matches_two", "value": true, "description": "单篇和两篇使用相同单卡尺寸。" },
    { "rule": "overflow_uses_more_button", "value": true, "description": "超过三篇必须展示更多入口。" }
  ],
  "tokens": {
    "container.width": "media-note.container-width",
    "card.gap": "media-note.gap",
    "card.radius": "media-note.radius",
    "button.height": "media-note.more-height",
    "button.radius": "media-note.more-radius",
    "overlay": "always-media-overlay",
    "text": "always-white"
  },
  "haptics": { "open-note": "light", "open-more": "light" },
  "anatomy": [
    { "part": "cover", "tokens": ["card.radius"], "description": "3:4 裁切的笔记封面。" },
    { "part": "content", "tokens": ["overlay", "text"], "description": "底部渐变上的标题、作者和点赞信息。" },
    { "part": "more-button", "tokens": ["button.height", "button.radius"], "description": "超过三篇时展示总数。" }
  ],
  "doDont": {
    "do": ["保留笔记标题、作者与互动量。", "按输入顺序展示前三篇。"],
    "dont": ["不要把单篇卡拉满内容宽度。", "不要在三列模式继续使用大卡字号。"]
  }
}
