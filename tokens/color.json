{
  "$description": "Dots 颜色令牌。来源：references/color-tokens.md 与 Token-Color.pdf。Light/Dark 双模式通过 $extensions.modes 表达。",
  "color": {
    "bg": {
      "base": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Bg：基准层，主背景色",
        "$extensions": { "modes": { "dark": "#29292E" } }
      },
      "0": {
        "$value": "#F5F5F5",
        "$type": "color",
        "$description": "Bg 0：最底层，卡片容器后层背景",
        "$extensions": { "modes": { "dark": "#19191E" } }
      },
      "0-lighter": {
        "$value": "#FAFAFA",
        "$type": "color",
        "$description": "Bg 0 Lighter：最底层浅色背景",
        "$extensions": { "modes": { "dark": "#141418" } }
      },
      "1": {
        "$value": "#F5F5F5",
        "$type": "color",
        "$description": "Bg 1：基准层上模块背景",
        "$extensions": { "modes": { "dark": "#222226" } }
      },
      "2": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Bg 2：弹出层等最高层背景",
        "$extensions": { "modes": { "dark": "#29292E" } }
      }
    },
    "title": {
      "$value": "rgba(0,0,0,0.8)",
      "$type": "color",
      "$description": "Title：一级标题",
      "$extensions": { "modes": { "dark": "rgba(255,255,255,0.84)" } }
    },
    "paragraph": {
      "$value": "rgba(0,0,0,0.62)",
      "$type": "color",
      "$description": "Paragraph：二级标题、段落",
      "$extensions": { "modes": { "dark": "rgba(255,255,255,0.56)" } }
    },
    "description": {
      "$value": "rgba(0,0,0,0.45)",
      "$type": "color",
      "$description": "Description：描述、未选中文字",
      "$extensions": { "modes": { "dark": "rgba(255,255,255,0.36)" } }
    },
    "disabled": {
      "$value": "rgba(0,0,0,0.27)",
      "$type": "color",
      "$description": "Disabled：禁用色",
      "$extensions": { "modes": { "dark": "rgba(255,255,255,0.21)" } }
    },
    "placeholder": {
      "$value": "rgba(0,0,0,0.27)",
      "$type": "color",
      "$description": "Placeholder：占位文本色",
      "$extensions": { "modes": { "dark": "rgba(255,255,255,0.21)" } }
    },
    "link": {
      "$value": "#133667",
      "$type": "color",
      "$description": "Link：段落和话题链接",
      "$extensions": { "modes": { "dark": "#C6D9EF" } }
    },
    "link-accent": {
      "$value": "#3D8AF5",
      "$type": "color",
      "$description": "Link Accent：强调链接",
      "$extensions": { "modes": { "dark": "#C6D9EF" } }
    },
    "fill": {
      "1": {
        "$value": "rgba(48,48,52,0.05)",
        "$type": "color",
        "$description": "Fill 1：次级按钮、标签、输入框底色",
        "$extensions": { "modes": { "dark": "rgba(255,255,255,0.04)" } }
      },
      "2": {
        "$value": "rgba(48,48,52,0.1)",
        "$type": "color",
        "$description": "Fill 2：操作组件按下色",
        "$extensions": { "modes": { "dark": "rgba(255,255,255,0.08)" } }
      },
      "3": {
        "$value": "rgba(48,48,52,0.2)",
        "$type": "color",
        "$description": "Fill 3：弱标签色",
        "$extensions": { "modes": { "dark": "rgba(255,255,255,0.125)" } }
      },
      "4": {
        "$value": "rgba(48,48,52,0.5)",
        "$type": "color",
        "$description": "Fill 4：标签色",
        "$extensions": { "modes": { "dark": "rgba(255,255,255,0.32)" } }
      },
      "5": {
        "$value": "rgba(48,48,52,0.99)",
        "$type": "color",
        "$description": "Fill 5：强标签、气泡、轻提示底色",
        "$extensions": { "modes": { "dark": "rgba(255,255,255,0.99)" } }
      }
    },
    "inverted-fill": {
      "1": {
        "$value": "rgba(255,255,255,0.04)",
        "$type": "color",
        "$description": "Inverted Fill 1：反色次级按钮、标签、输入框底色",
        "$extensions": { "modes": { "dark": "rgba(48,48,52,0.05)" } }
      },
      "2": {
        "$value": "rgba(255,255,255,0.08)",
        "$type": "color",
        "$description": "Inverted Fill 2：反色操作组件按下色",
        "$extensions": { "modes": { "dark": "rgba(48,48,52,0.1)" } }
      },
      "3": {
        "$value": "rgba(255,255,255,0.125)",
        "$type": "color",
        "$description": "Inverted Fill 3：反色弱标签色",
        "$extensions": { "modes": { "dark": "rgba(48,48,52,0.2)" } }
      },
      "4": {
        "$value": "rgba(255,255,255,0.32)",
        "$type": "color",
        "$description": "Inverted Fill 4：反色标签色",
        "$extensions": { "modes": { "dark": "rgba(48,48,52,0.5)" } }
      },
      "5": {
        "$value": "rgba(255,255,255,0.99)",
        "$type": "color",
        "$description": "Inverted Fill 5：反色强标签、气泡、轻提示底色",
        "$extensions": { "modes": { "dark": "rgba(48,48,52,0.99)" } }
      }
    },
    "separator": {
      "base": {
        "$value": "rgba(0,0,0,0.08)",
        "$type": "color",
        "$description": "Separator：分割线、描边",
        "$extensions": { "modes": { "dark": "rgba(255,255,255,0.12)" } }
      },
      "2": {
        "$value": "rgba(0,0,0,0.2)",
        "$type": "color",
        "$description": "Separator 2：较深色二级描边",
        "$extensions": { "modes": { "dark": "rgba(255,255,255,0.16)" } }
      },
      "opaque": {
        "$value": "#EAEAEA",
        "$type": "color",
        "$description": "Opaque Separator：多条线重叠时使用",
        "$extensions": { "modes": { "dark": "#222226" } }
      }
    },
    "xhs": {
      "red": {
        "$value": "#FF2442",
        "$type": "color",
        "$description": "XHS Red：小红书品牌强调色",
        "$extensions": { "modes": { "dark": "#FF2E4D" } }
      },
      "red-soft": {
        "$value": "#FFEDF0",
        "$type": "color",
        "$description": "XHS Red Soft：小红书品牌弱强调背景",
        "$extensions": { "modes": { "dark": "#301C1F" } }
      }
    },
    "warning": {
      "$value": "#FF7D03",
      "$type": "color",
      "$description": "Warning：警告填充及浅色填充上的文字",
      "$extensions": { "modes": { "dark": "#FF9E3D" } }
    },
    "warning-soft": {
      "$value": "#FFF2E6",
      "$type": "color",
      "$description": "Warning Soft：警告浅色填充",
      "$extensions": { "modes": { "dark": "#30271F" } }
    },
    "success": {
      "$value": "#02B940",
      "$type": "color",
      "$description": "Success：成功填充及浅色填充上的文字",
      "$extensions": { "modes": { "dark": "#36E271" } }
    },
    "success-soft": {
      "$value": "#EAF8EF",
      "$type": "color",
      "$description": "Success Soft：成功浅色填充",
      "$extensions": { "modes": { "dark": "#1C2E22" } }
    },
    "info": {
      "$value": "#3D8AF5",
      "$type": "color",
      "$description": "Info：信息填充及浅色填充上的文字",
      "$extensions": { "modes": { "dark": "#4790F5" } }
    },
    "info-soft": {
      "$value": "#ECF4FE",
      "$type": "color",
      "$description": "Info Soft：信息浅色填充",
      "$extensions": { "modes": { "dark": "#1D2633" } }
    },
    "neutral": {
      "white": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "White：主题自适应白色",
        "$extensions": { "modes": { "dark": "#000000" } }
      },
      "black": {
        "$value": "#000000",
        "$type": "color",
        "$description": "Black：主题自适应黑色",
        "$extensions": { "modes": { "dark": "#FFFFFF" } }
      }
    },
    "dots-accent": {
      "surface": {
        "$value": "rgba(86,209,191,0.08)",
        "$type": "color",
        "$description": "Dots Accent Surface：标签等浅品牌背景",
        "$extensions": { "modes": { "dark": "rgba(86,209,191,0.12)" } }
      },
      "text": {
        "$value": "#56D1BF",
        "$type": "color",
        "$description": "Dots Accent Text：品牌文字和图标"
      },
      "fill": {
        "$value": "#56D1BF",
        "$type": "color",
        "$description": "Dots Accent Fill：按钮、开关等交互底色"
      },
      "border-subtle": {
        "$value": "rgba(86,209,191,0.1)",
        "$type": "color",
        "$description": "Dots Accent Border Subtle：标签低强调描边"
      },
      "border": {
        "$value": "rgba(86,209,191,0.4)",
        "$type": "color",
        "$description": "Dots Accent Border：按钮中强调描边"
      },
      "icon-muted": {
        "$value": "rgba(52,179,157,0.4)",
        "$type": "color",
        "$description": "Dots Accent Icon Muted：弱化辅助图标"
      },
      "highlight": {
        "$value": "rgba(86,209,191,0.12)",
        "$type": "color",
        "$description": "Dots Accent Highlight：高亮答案底色"
      }
    },
    "mask-bg": {
      "$value": "rgba(0,0,0,0.4)",
      "$type": "color",
      "$description": "Mask Bg：Always Mode 遮罩背景"
    },
    "light": {
      "title": { "$value": "rgba(255,255,255,0.84)", "$type": "color", "$description": "Light Title：亮色一级标题" },
      "paragraph": { "$value": "rgba(255,255,255,0.56)", "$type": "color", "$description": "Light Paragraph：亮色二级标题、段落" },
      "description": { "$value": "rgba(255,255,255,0.36)", "$type": "color", "$description": "Light Description：亮色描述" },
      "disabled": { "$value": "rgba(255,255,255,0.21)", "$type": "color", "$description": "Light Disabled：亮色禁用" },
      "fill-1": { "$value": "rgba(255,255,255,0.04)", "$type": "color", "$description": "Light Fill 1" },
      "fill-2": { "$value": "rgba(255,255,255,0.08)", "$type": "color", "$description": "Light Fill 2" },
      "fill-3": { "$value": "rgba(255,255,255,0.125)", "$type": "color", "$description": "Light Fill 3" },
      "fill-4": { "$value": "rgba(255,255,255,0.32)", "$type": "color", "$description": "Light Fill 4" },
      "fill-5": { "$value": "rgba(255,255,255,0.99)", "$type": "color", "$description": "Light Fill 5" },
      "separator": { "$value": "rgba(255,255,255,0.07)", "$type": "color", "$description": "Light Separator" },
      "separator-2": { "$value": "rgba(255,255,255,0.16)", "$type": "color", "$description": "Light Separator 2" }
    },
    "dark": {
      "title": { "$value": "rgba(0,0,0,0.8)", "$type": "color", "$description": "Dark Title：暗色一级标题" },
      "paragraph": { "$value": "rgba(0,0,0,0.62)", "$type": "color", "$description": "Dark Paragraph：暗色二级标题、段落" },
      "description": { "$value": "rgba(0,0,0,0.45)", "$type": "color", "$description": "Dark Description：暗色描述" },
      "disabled": { "$value": "rgba(0,0,0,0.27)", "$type": "color", "$description": "Dark Disabled：暗色禁用" },
      "fill-1": { "$value": "rgba(48,48,52,0.05)", "$type": "color", "$description": "Dark Fill 1" },
      "fill-2": { "$value": "rgba(48,48,52,0.1)", "$type": "color", "$description": "Dark Fill 2" },
      "fill-3": { "$value": "rgba(48,48,52,0.2)", "$type": "color", "$description": "Dark Fill 3" },
      "fill-4": { "$value": "rgba(48,48,52,0.5)", "$type": "color", "$description": "Dark Fill 4" },
      "fill-5": { "$value": "rgba(48,48,52,0.99)", "$type": "color", "$description": "Dark Fill 5" },
      "separator": { "$value": "rgba(0,0,0,0.08)", "$type": "color", "$description": "Dark Separator" },
      "separator-2": { "$value": "rgba(0,0,0,0.2)", "$type": "color", "$description": "Dark Separator 2" }
    },
    "always": {
      "white": { "$value": "#FFFFFF", "$type": "color", "$description": "White：Always Mode 白色" },
      "black": { "$value": "#000000", "$type": "color", "$description": "Black：Always Mode 黑色" },
      "media-overlay": { "$value": "rgba(36,36,36,0.32)", "$type": "color", "$description": "媒体卡底部文字蒙层" },
      "video-control-overlay": { "$value": "rgba(0,0,0,0.20)", "$type": "color", "$description": "横版视频底部控件渐变终点" },
      "video-duration-shadow": { "$value": "rgba(0,0,0,0.12)", "$type": "color", "$description": "横版视频右上时长局部遮罩" },
      "ask-dots-action": { "$value": "#34B39D", "$type": "color", "$description": "问点点搜索引导的立即总结文字" },
      "ask-dots-island-surface": { "$value": "rgba(255,255,255,0.80)", "$type": "color", "$description": "问点点搜索引导新版玻璃表面" },
      "ask-dots-island-border": { "$value": "rgba(86,209,191,0.20)", "$type": "color", "$description": "问点点搜索引导新版薄荷描边" }
    },
    "legacy": {
      "accent-yellow": { "$value": "#FFCC00", "$type": "color", "$description": "兼容旧页面，不属于现行颜色规范" },
      "accent-green": { "$value": "#34C759", "$type": "color", "$description": "兼容旧页面，不属于现行颜色规范" },
      "accent-pink": { "$value": "#FF6482", "$type": "color", "$description": "兼容旧页面，不属于现行颜色规范" },
      "accent-brown": { "$value": "#916964", "$type": "color", "$description": "兼容旧页面，不属于现行颜色规范" },
      "accent-event-blue": { "$value": "#5B9BDB", "$type": "color", "$description": "兼容旧页面，不属于现行颜色规范" },
      "deco-teal": { "$value": "#81D5CA", "$type": "color", "$description": "兼容旧页面，不属于现行颜色规范" },
      "deco-sky": { "$value": "#84B1EB", "$type": "color", "$description": "兼容旧页面，不属于现行颜色规范" },
      "deco-lavender": { "$value": "#9F8CCF", "$type": "color", "$description": "兼容旧页面，不属于现行颜色规范" },
      "deco-sage": { "$value": "#A0C484", "$type": "color", "$description": "兼容旧页面，不属于现行颜色规范" },
      "deco-rose": { "$value": "#AA7D78", "$type": "color", "$description": "兼容旧页面，不属于现行颜色规范" }
