{
  "$description": "Dots 动效。来源：点点设计规范 6 动画规范。",
  "duration": {
    "in": { "$value": "250ms", "$type": "duration", "$description": "元素入场" },
    "expand": { "$value": "350ms", "$type": "duration", "$description": "内容展开" },
    "delayed-in": { "$value": "300ms", "$type": "duration", "$description": "延迟入场" },
    "out": { "$value": "250ms", "$type": "duration", "$description": "元素退场" },
    "sheet": { "$value": "400ms", "$type": "duration", "$description": "弹窗/底部弹窗出入场，允许 350-450ms" },
    "morph": { "$value": "800ms", "$type": "duration", "$description": "大幅共享元素形变，容纳轻微越界与回稳" },
    "fast": { "$value": "250ms", "$type": "duration", "$description": "兼容旧变量：状态切换" },
    "normal": { "$value": "250ms", "$type": "duration", "$description": "兼容旧变量：页面切换" },
    "slow": { "$value": "350ms", "$type": "duration", "$description": "兼容旧变量：大幅位移" }
  },
  "curve": {
    "out": {
      "$value": "cubic-bezier(.32,.72,0,1)",
      "$type": "cubicBezier",
      "$description": "通用出场/进入"
    },
    "spring": {
      "$value": "cubic-bezier(.34,1.56,.64,1)",
      "$type": "cubicBezier",
      "$description": "弹性效果"
    },
    "morph-spring": {
      "$value": "linear(0, 0.053 5%, 0.175 10%, 0.3246 15%, 0.4754 20%, 0.6122 25%, 0.7277 30%, 0.8197 35%, 0.8893 40%, 0.9394 45%, 0.9734 50%, 0.9949 55%, 1.012 60%, 1.024 65%, 1.03 70%, 1.028 75%, 1.022 80%, 1.015 85%, 1.009 90%, 1.004 95%, 1)",
      "$type": "string",
      "$description": "共享元素展开弹簧；约 70% 时越过目标 3%，随后回到精确尺寸"
    },
    "morph-settle": {
      "$value": "linear(0, 0.035 5%, 0.09 10%, 0.16 15%, 0.24 20%, 0.32 25%, 0.4 30%, 0.48 35%, 0.55 40%, 0.62 45%, 0.68 50%, 0.73 55%, 0.78 60%, 0.82 65%, 0.86 70%, 0.91 75%, 0.98 80%, 1.03 85%, 1.015 90%, 1.004 95%, 1)",
      "$type": "string",
      "$description": "共享元素收回弹簧；前段保留形变可读性，最后 25% 加速归位，并在约 85% 时越过目标 3% 后回稳"
    },
    "default": {
      "$value": "cubic-bezier(.32,.72,0,1)",
      "$type": "cubicBezier",
      "$description": "兼容旧变量：映射到 Dots ease-out"
    },
    "ease-out": {
      "$value": "cubic-bezier(.32,.72,0,1)",
      "$type": "cubicBezier",
      "$description": "兼容旧变量：映射到 Dots ease-out"
    }
  },
  "press": {
    "scale-min": { "$value": "0.95", "$type": "number", "$description": "按压缩放下限" },
    "scale-max": { "$value": "0.97", "$type": "number", "$description": "按压缩放上限" },
    "opacity": { "$value": "0.5", "$type": "number", "$description": "按压透明度" }
  }
}
